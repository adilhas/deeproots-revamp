generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PrivateSeedSubmission {
  id                   String            @id @default(cuid())
  fullName             String
  email                String            @unique
  contact              String
  country              String
  website              String
  capital              String
  value                String
  whyJoin              String
  indvOrOrg            String
  applicationStatus    String            @default("received")
  createdAt            DateTime          @default(now())
  dealRoomOpen         Boolean           @default(false)
  preApproval          String            @default("not-submitted")
  preApprovalUpdatedAt DateTime?
  firstReminderSent    Boolean           @default(false)
  secondReminderSent   Boolean           @default(false)
  updatedAt            DateTime          @updatedAt
  passwordHash         String?
  dealRoom             String            @default("not-submitted")
  kycDocuments         KycDocument[]
  ndaSubmission        NdaSubmission?
  paymentDetails       PaymentDetails?
  usdtAddress          String?
  usdcAddress          String?
  contributionAmount   String?
  seedTier             String?
  managementNotes      ManagementNotes[]
  isDealRoomExpired    Boolean           @default(false)
  notifications        Notification[]   

  @@index([id])
  @@index([email])
  @@index([preApprovalUpdatedAt])
}

model PaymentDetails {
  id              String                @id @default(cuid())
  amountSent      String
  transactionLink String
  paymentImage    String
  submissionId    String                @unique
  updatedAt       DateTime?             @updatedAt
  createdAt       DateTime              @default(now())
  declineReason   String?
  paymentStatus   String                @default("not-submitted")
  receiptUrl      String?
  submission      PrivateSeedSubmission @relation(fields: [submissionId], references: [id])

  @@index([paymentStatus])
  @@index([updatedAt])
}

model SeederAccountToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model KycDocument {
  id        String                @id @default(cuid())
  type      KycDocumentType
  url       String
  userId    String
  createdAt DateTime              @default(now())
  user      PrivateSeedSubmission @relation(fields: [userId], references: [id])

  @@index([id])
}

model NdaSubmission {
  id             String                @id @default(cuid())
  userId         String                @unique
  typedSignature String
  signatureImage String
  acceptedAt     DateTime              @default(now())
  updatedAt      DateTime?             @updatedAt
  user           PrivateSeedSubmission @relation(fields: [userId], references: [id])

  @@index([id])
}

enum SenderType {
  ADMIN
  SEEDER
}

model ManagementNotes {
  id           String                @id @default(cuid())
  note         String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  submissionId String
  submission   PrivateSeedSubmission @relation(fields: [submissionId], references: [id])
  sender       SenderType

  @@index([submissionId])
}

model BoradcastMessage {
  id           String                @id @default(cuid())
  message         String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model Announcement {
  id           String                @id @default(cuid())
  message         String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

enum KycDocumentType {
  PASSPORT
  PROOF_OF_ADDRESS
  SELFIE_WITH_NOTE
  BUSINESS_LICENSE
  COMPANY_ADDRESS
  AUTHORIZATION_LETTER
  REP_ID_SELFIE
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String
  thumbnail String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tags      String[]
}

model Notification {
  id              String                @id @default(cuid())
   title           String
  message         String
  type            NotificationType      @default(INFO)
  isRead          Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  submissionId    String?              
  submission      PrivateSeedSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  sender          SenderType            @default(ADMIN)
  link            String?
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  token      String   @unique
  email      String
  used       Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}