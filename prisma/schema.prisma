generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("NEXT_DATABASE_URL")
}

model PrivateSeedSubmission {
  id                String   @id @default(cuid())
  fullName          String
  email             String   @unique
  contact           String
  country           String
  website           String
  capital           String
  value             String
  whyJoin           String
  canPassKyc        Boolean
  indvOrOrg         String
  confidentiality   Boolean
  acknowledgement   Boolean
  disclosureTerm    Boolean
  nonUsCitizen      Boolean
  applicationStatus String   @default("Received")
  createdAt         DateTime @default(now())

  seederUser        SeederUser? @relation(name: "ApplicationToUser")
}

model SeederAccountToken {
  id         String   @id @default(cuid())
  email      String   
  token      String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model SeederUser {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  application        PrivateSeedSubmission @relation(name: "ApplicationToUser", fields: [applicationId], references: [id])
  applicationId      String   @unique
  createdAt          DateTime @default(now())
}
