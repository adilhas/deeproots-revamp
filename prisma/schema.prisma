generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PrivateSeedSubmission {
  id                String          @id @default(cuid())
  fullName          String
  email             String          @unique
  contact           String
  country           String
  website           String
  capital           String
  value             String
  whyJoin           String
  indvOrOrg         String
  applicationStatus String          @default("received")
  createdAt         DateTime        @default(now())
  dealRoomOpen      Boolean         @default(false)
  preApproval       String          @default("not-submitted")
  updatedAt         DateTime        @updatedAt
  passwordHash      String?
  dealRoom          String          @default("not-submitted")
  kycDocuments      KycDocument[]
  ndaSubmission     NdaSubmission?
  paymentDetails    PaymentDetails?
}

model PaymentDetails {
  id              String                @id @default(cuid())
  amountSent      String
  transactionLink String
  paymentImage    String
  submissionId    String                @unique
  updatedAt       DateTime              @updatedAt
  createdAt       DateTime              @default(now())
  declineReason   String?
  paymentStatus   String                @default("not-submitted")
  receiptUrl      String?
  submission      PrivateSeedSubmission @relation(fields: [submissionId], references: [id])
}

model SeederAccountToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model KycDocument {
  id        String                @id @default(cuid())
  type      KycDocumentType
  url       String
  userId    String
  createdAt DateTime              @default(now())
  user      PrivateSeedSubmission @relation(fields: [userId], references: [id])
}

model NdaSubmission {
  id             String                @id @default(cuid())
  userId         String                @unique
  typedSignature String
  signatureImage String
  acceptedAt     DateTime              @default(now())
  user           PrivateSeedSubmission @relation(fields: [userId], references: [id])
}

enum KycDocumentType {
  PASSPORT
  PROOF_OF_ADDRESS
  SELFIE_WITH_NOTE
  BUSINESS_LICENSE
  COMPANY_ADDRESS
  AUTHORIZATION_LETTER
  REP_ID_SELFIE
}
