generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PrivateSeedSubmission {
   id                   String            @id @default(cuid())
  fullName             String
  email                String            @unique
  contact              String
  country              String
  website              String
  capital              String
  value                String
  whyJoin              String
  indvOrOrg            String
  applicationStatus    String            @default("received")
  createdAt            DateTime          @default(now())
  dealRoomOpen         Boolean           @default(false)
  preApproval          String            @default("not-submitted")
  updatedAt            DateTime          @updatedAt
  passwordHash         String?
  dealRoom             String            @default("not-submitted")
  usdcAddress          String?
  usdtAddress          String?
  contributionAmount   String?
  seedTier             String?
  preApprovalUpdatedAt DateTime?
  firstReminderSent    Boolean           @default(false)
  secondReminderSent   Boolean           @default(false)
  isDealRoomExpired    Boolean           @default(false)
  kycDocuments         KycDocument[]
  managementNotes      ManagementNotes[]
  ndaSubmission        NdaSubmission?
  notifications        Notification[]
  paymentDetails       PaymentDetails?
  morePayments    MorePayment[] 
  canAddFund      String @default("not-submitted")

  @@index([id])
  @@index([email])
  @@index([preApprovalUpdatedAt])
}

model PaymentDetails {
  id              String                @id @default(cuid())
  amountSent      String
  transactionLink String
  paymentImage    String
  submissionId    String                @unique
  updatedAt       DateTime?             @updatedAt
  createdAt       DateTime              @default(now())
  declineReason   String?
  paymentStatus   String                @default("not-submitted")
  receiptUrl      String?
  submission      PrivateSeedSubmission @relation(fields: [submissionId], references: [id])

  @@index([paymentStatus])
  @@index([updatedAt])
}
model MorePayment {
  id               String                @id @default(cuid())
  requestedAmount  String                // amount user wishes to add
  amountSent       String?               // actual amount user sent (after approval)
  transactionLink  String?
  paymentImage     String?
  receiptUrl       String?
  comment          String?               // user comment
  adminComment     String?               // admin note for request/payment
  status           PaymentStatus         @default(requested)
  submissionId     String
  submission       PrivateSeedSubmission @relation(fields: [submissionId], references: [id])
  
  // timestamps
  createdAt        DateTime              @default(now())
  updatedAt        DateTime?             @updatedAt
  requestApprovedAt DateTime?
  paymentSubmittedAt DateTime?
  paymentApprovedAt DateTime?

  @@index([submissionId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentStatus {
  requested           
  request_approved    
  request_rejected    
  payment_submitted   
  payment_approved    
  payment_rejected    
}


model SeederAccountToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model KycDocument {
  id        String          @id @default(cuid())
  type      KycDocumentType
  url       String
  userId    String
  createdAt DateTime        @default(now())
  user      PrivateSeedSubmission @relation(fields: [userId], references: [id])

  @@index([id])
}

model NdaSubmission {
  id             String    @id @default(cuid())
  userId         String    @unique
  typedSignature String
  signatureImage String
  acceptedAt     DateTime  @default(now())
  updatedAt      DateTime? @updatedAt
  user           PrivateSeedSubmission @relation(fields: [userId], references: [id])

  @@index([id])
}

model ManagementNotes {
  id           String     @id @default(cuid())
  note         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  submissionId String
  sender       SenderType
  submission   PrivateSeedSubmission @relation(fields: [submissionId], references: [id])

  @@index([submissionId])
}

model BoradcastMessage {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  slug      String    @unique
  content   String
  thumbnail String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tags      String[]
}

model Notification {
  id           String           @id @default(cuid())
  message      String
  type         NotificationType @default(INFO)
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  submissionId String?
  sender       SenderType       @default(ADMIN)
  link         String?
  title        String
  submission   PrivateSeedSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model documents {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content   String?
  metadata  Json?
  embedding Unsupported("vector")?
}

enum SenderType {
  ADMIN
  SEEDER
}

enum KycDocumentType {
  PASSPORT
  PROOF_OF_ADDRESS
  SELFIE_WITH_NOTE
  BUSINESS_LICENSE
  COMPANY_ADDRESS
  AUTHORIZATION_LETTER
  REP_ID_SELFIE
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}
