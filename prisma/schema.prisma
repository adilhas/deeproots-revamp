generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("NEXT_DATABASE_URL")
}

enum KycDocumentType {
  PASSPORT
  PROOF_OF_ADDRESS
  SELFIE_WITH_NOTE
  BUSINESS_LICENSE
  COMPANY_ADDRESS
  AUTHORIZATION_LETTER
  REP_ID_SELFIE
}

model PrivateSeedSubmission {
  id                String   @id @default(cuid())
  fullName          String
  email             String   @unique
  passwordHash      String?   
  contact           String
  country           String
  website           String
  capital           String
  value             String
  whyJoin           String
  indvOrOrg         String
  applicationStatus String   @default("received")
  preApproval       String   @default("not-submitted")
  dealRoomOpen      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  kycDocuments      KycDocument[]
  ndaSubmission     NdaSubmission?
}

model SeederAccountToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}


model KycDocument {
  id        String                 @id @default(cuid())
  type      KycDocumentType
  url       String
  userId    String
  user      PrivateSeedSubmission @relation(fields: [userId], references: [id])
  createdAt DateTime              @default(now())
}

model NdaSubmission {
  id             String                 @id @default(cuid())
  userId         String                 @unique
  user           PrivateSeedSubmission @relation(fields: [userId], references: [id])
  typedSignature String
  signatureImage String
  acceptedAt     DateTime              @default(now())
}
