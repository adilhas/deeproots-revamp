generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("NEXT_DATABASE_URL")
}

model PrivateSeedSubmission {
  id                String   @id @default(cuid())
  fullName          String
  email             String
  contact           String
  country           String
  website           String
  capital           String
  value             String
  whyJoin           String
  canPassKyc        Boolean
  indvOrOrg         String
  confidentiality   Boolean
  acknowledgement   Boolean
   disclosureTerm    Boolean   // ✅ Newly added
  nonUsCitizen      Boolean 
  applicationStatus String   @default("Received")
  createdAt         DateTime @default(now())
}